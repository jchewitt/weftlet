# Copy and adapt to .github/workflows/weftlet-check.yml in a consumer project.
name: Weftlet configuration checks
on: [pull_request, push]
permissions:
  contents: read
jobs:
  configuration:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: 24
          cache: npm
      - run: npm ci
      - run: npx --no-install weftlet config validate
      - run: npx --no-install weftlet hydrate --plan --ref HEAD --json
      # Add the project's own tests and deterministic architecture policy here.
      # No provider credentials, model calls, hydration or private graph upload.
