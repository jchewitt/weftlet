{
  "schemaVersion": 1,
  "repositoryRoot": ".",
  "repositoryId": "public/business-context",
  "namespace": "https://example.test/context/",
  "semanticSources": [
    "docs"
  ],
  "codeRoots": [
    "services",
    "apps",
    "packages",
    "tests"
  ],
  "contractPatterns": [],
  "evidenceRoots": [
    "tests"
  ],
  "semantic": {
    "provider": "module",
    "model": "offline-grammar",
    "reasoningEffort": "medium",
    "promptVersion": "generic-semantic-v3",
    "extractorVersion": "1.1.0",
    "adapterVersion": "1.1.0",
    "ontologyVersion": "1.1.0",
    "minimumConfidence": 0.7,
    "failOnUnresolved": true,
    "concurrency": 1,
    "providerModule": "./provider.mjs",
    "providerIdentity": "public-business-context-parser:1",
    "maxDocuments": 8,
    "maxSourceBytes": 65536,
    "timeoutMs": 120000,
    "retries": 0
  },
  "scip": {
    "version": "0.4.0",
    "command": "bundled-scip-typescript",
    "args": [
      "index",
      "--no-global-caches"
    ],
    "sourceProject": {
      "include": [
        "services/**/*.ts",
        "apps/**/*.tsx",
        "packages/**/*.ts",
        "tests/**/*.ts"
      ],
      "aliases": {
        "@public/contracts": "packages/contracts/src/index.ts",
        "@public/math": "packages/math/src/index.ts"
      }
    }
  },
  "ontology": {
    "backend": "rdf",
    "toolVersion": "rdf-record-v1"
  },
  "runtimeEvidence": [],
  "storagePath": ".context-graph",
  "approvedIntentSources": [
    "docs/**"
  ]
}
